PORT=4000

# --- Base de datos ---
# Opción A (recomendada, gratis y persistente): Turso (libSQL remoto).
#   Crea la DB en https://app.turso.tech y pega aquí la URL y el token.
LIBSQL_URL=libsql://tu-db-tu-usuario.turso.io
LIBSQL_AUTH_TOKEN=cambia_este_token
#
# Opción B (solo desarrollo local): si NO defines LIBSQL_URL, se usa un
# archivo SQLite local. La ruta se puede forzar con DB_PATH.
# DB_PATH=./db/fitcore.db

JWT_SECRET=cambia_este_valor_por_uno_seguro
JWT_EXPIRES_IN=2h

# --- Correo de bienvenida (opcional) ---
# Si dejas estos campos vacíos, el registro funciona igual pero no se envía correo.
# Ejemplo con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=tucorreo@gmail.com, SMTP_PASS=<contraseña de aplicación de Gmail, no tu contraseña normal>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
